# Copy to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql://postgres.xxxxxxxx:your-password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# Generate with: openssl rand -base64 32
JWT_SECRET=

PORT=8080
CORS_ORIGIN=http://localhost:5173

# This backend's own public URL — used to build OAuth callback URLs
# registered in each provider's console. Defaults to
# http://localhost:$PORT if unset, which is fine for local dev.
BASE_URL=http://localhost:8080

# OAuth is entirely optional — leave a provider's ID/secret unset and
# it's simply unavailable (the frontend gets a clean error instead of
# the backend refusing to start). Each needs an app registered in that
# provider's console, with its callback URL set to
# {BASE_URL}/api/oauth/google/callback (or /github/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the frontend actually lives — used to build the link inside
# verification emails (e.g. https://typebook.vercel.app). Defaults to
# the local Vite dev server if unset.
FRONTEND_URL=http://localhost:5173

# Optional — real email delivery via Resend (https://resend.com).
# Leave RESEND_API_KEY unset to fall back to logging the link to the
# console instead (fine for local dev, NOT fine for a real deployment —
# real users will never see the link without this set).
RESEND_API_KEY=
# Must be on a domain verified in your Resend account. Until you verify
# one, Resend only lets you send from onboarding@resend.dev, and only to
# the email address you signed up with.
EMAIL_FROM=onboarding@resend.dev
